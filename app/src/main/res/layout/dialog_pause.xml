<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="420dp" android:layout_height="wrap_content" android:background="@color/bg" android:padding="20dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Пауза" android:textColor="@color/text" android:textSize="22sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="✕ выбрать · ○ продолжить · Back в библиотеку" android:textColor="@color/text_dim" android:textSize="13sp" />
        <Button android:id="@+id/btnResume" style="@style/PauseButton" android:text="@string/resume" />
        <Button android:id="@+id/btnSave" style="@style/PauseButton" android:text="@string/save_state" />
        <Button android:id="@+id/btnLoad" style="@style/PauseButton" android:text="@string/load_state" />
        <Button android:id="@+id/btnFilter" style="@style/PauseButton" android:text="@string/filter" />
        <Button android:id="@+id/btnAudioInfo" style="@style/PauseButton" android:text="Диагностика звука" />
        <Button android:id="@+id/btnExit" style="@style/PauseButton" android:text="@string/exit_to_menu" />
        <Button android:id="@+id/btnExitApp" style="@style/PauseButton" android:text="Сохранить и выйти из приложения" />
    </LinearLayout>
</ScrollView>
