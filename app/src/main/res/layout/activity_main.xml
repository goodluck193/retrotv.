<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/bg" android:padding="28dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/app_name" android:textColor="@color/text" android:textSize="28sp" android:textStyle="bold" />
        <Button android:id="@+id/btnAddRom" style="@style/PauseButton" android:layout_width="wrap_content" android:text="@string/add_rom" />
        <Button android:id="@+id/btnSettings" style="@style/PauseButton" android:layout_width="wrap_content" android:layout_marginStart="12dp" android:text="@string/settings" />
        <Button android:id="@+id/btnExitApp" style="@style/PauseButton" android:layout_width="wrap_content" android:layout_marginStart="12dp" android:text="@string/exit_app" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center_vertical">
        <Button android:id="@+id/btnCategory" style="@style/PauseButton" android:layout_width="200dp" android:text="@string/all_games" />
        <EditText android:id="@+id/searchGames" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginStart="20dp" android:hint="@string/search_hint" android:textColor="@color/text" android:textColorHint="@color/text_dim" android:inputType="text" android:singleLine="true" android:imeOptions="actionDone" android:textSize="16sp" android:importantForAutofill="no" />
    </LinearLayout>
    <TextView android:id="@+id/libraryCount" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/text_dim" android:textSize="12sp" />
    <TextView android:id="@+id/emptyView" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:gravity="center" android:text="@string/empty_hint" android:textColor="@color/text_dim" android:textSize="17sp" android:visibility="gone" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/gameList" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="8dp" android:clipToPadding="false" android:padding="6dp" />
</LinearLayout>
